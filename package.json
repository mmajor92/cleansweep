{
  "name": "cleansweep",
  "version": "0.1.0",
  "description": "A daily chain of higher or lower questions across length, weight, date, count and speed.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint:data": "node scripts/lint.mjs",
    "lint:strict": "node scripts/lint.mjs --strict",
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "npm run lint:data && npm test",
    "harvest": "node scripts/harvest.mjs",
    "generate:ahead": "node scripts/generate.mjs --days 21"
  }
}
